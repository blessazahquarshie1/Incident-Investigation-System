{
"openapi":"3.0.3",
"info":{"title":"Investigation-Man-Sys API","version":"0.1.0","description":"Rust (Axum + SQLx) backend on Postgres. Reads: one snapshot endpoint. Writes: per-action endpoints, each in one transaction, logging activity and returning `{id, data}` (fresh snapshot) or `{case, activity, ...}` for case-level edits. Send `X-Officer-Id` to say who is acting."},
"servers":[{"url":"/api"}],
"tags":[{"name":"System"},{"name":"Cases"},{"name":"People"},{"name":"Incidents"},{"name":"Evidence"},{"name":"Vehicles"},{"name":"Locations"},{"name":"Timeline records"},{"name":"Graph"}],
"components":{"parameters":{"ActingOfficer":{"name":"X-Officer-Id","in":"header","required":false,"description":"Acting officer (no auth yet)","schema":{"type":"string","default":"O-001"}}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string"}}},"CaseType":{"type":"string","enum":["theft","fraud","assault","cybercrime","other"]},"Priority":{"type":"string","enum":["low","medium","high","critical"]},"CaseStatus":{"type":"string","enum":["open","investigating","pending","closed"]},"PersonType":{"type":"string","enum":["suspect","witness","victim","person-of-interest"]},"IncidentStatus":{"type":"string","enum":["unresolved","resolved"]},"DocKind":{"type":"string","enum":["report","warrant","statement","court-order","other"]},"EvidenceType":{"type":"string","enum":["document","photo","video","device","vehicle","digital"]},"CustodyAction":{"type":"string","enum":["collected","transferred","submitted-to-evidence-room","analysis-started","analysis-completed","released","destroyed"]},"Relationship":{"type":"string","enum":["owns","visited","witnessed","involved-in","connected-to"]},"SightingSource":{"type":"string","enum":["cctv","patrol","anpr","informant"]},"SightingAction":{"type":"string","enum":["entered","left","seen"]},"PhoneKind":{"type":"string","enum":["call","sms","cell-tower"]},"Case":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"description":{"type":"string"},"type":{"$ref":"#/components/schemas/CaseType"},"priority":{"$ref":"#/components/schemas/Priority"},"status":{"$ref":"#/components/schemas/CaseStatus"},"leadInvestigator":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"ActivityLogEntry":{"type":"object","properties":{"id":{"type":"string"},"caseId":{"type":"string"},"officerId":{"type":"string"},"timestamp":{"type":"string","format":"date-time"},"action":{"type":"string"},"description":{"type":"string"}}},"InvestigationData":{"type":"object","properties":{"officers":{"type":"array","items":{"type":"object"}},"locations":{"type":"array","items":{"type":"object"}},"cases":{"type":"array","items":{"type":"object"}},"persons":{"type":"array","items":{"type":"object"}},"incidents":{"type":"array","items":{"type":"object"}},"evidence":{"type":"array","items":{"type":"object"}},"vehicles":{"type":"array","items":{"type":"object"}},"documents":{"type":"array","items":{"type":"object"}},"notes":{"type":"array","items":{"type":"object"}},"witnessStatements":{"type":"array","items":{"type":"object"}},"sightings":{"type":"array","items":{"type":"object"}},"phoneRecords":{"type":"array","items":{"type":"object"}},"activityLog":{"type":"array","items":{"type":"object"}},"relationships":{"type":"array","items":{"type":"object"}}}},"MutationResult":{"type":"object","properties":{"id":{"type":"string","nullable":true,"description":"The created/affected record"},"data":{"$ref":"#/components/schemas/InvestigationData"}}},"ServerResult":{"type":"object","properties":{"case":{"$ref":"#/components/schemas/Case"},"activity":{"$ref":"#/components/schemas/ActivityLogEntry"},"note":{"type":"object"},"document":{"type":"object"}}}}},
"paths":{
"/health":{"get":{"tags":["System"],"summary":"Health check","responses":{"200":{"description":"API is up"}}}},
"/investigation":{"get":{"tags":["System"],"summary":"Full dataset snapshot","description":"Everything the frontend needs, in one call: officers, locations, cases, persons (with relatedCases), incidents, evidence (with custodyHistory + linkedPersons), vehicles, documents, notes, witnessStatements, sightings, phoneRecords, activityLog (newest first), relationships. **Every sidebar tab reads from this one snapshot** (loaded once at startup into the zustand store); filtering/search/graph/timeline logic runs client-side.","responses":{"200":{"description":"InvestigationData","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvestigationData"}}}}}}},
"/cases":{"post":{"tags":["Cases"],"summary":"Create a case","description":"ID comes from the CASE counter; status starts as `open`; logs `case-created`.","parameters":[{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"title":{"type":"string"},"description":{"type":"string"},"type":{"$ref":"#/components/schemas/CaseType"},"priority":{"$ref":"#/components/schemas/Priority"},"leadInvestigator":{"type":"string","example":"O-001"}},"required":["title","description","type","priority","leadInvestigator"]}}}}}},
"/cases/{caseId}/priority":{"patch":{"tags":["Cases"],"summary":"Change priority","description":"Logs `priority-changed`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"priority":{"$ref":"#/components/schemas/Priority"}},"required":["priority"]}}}}}},
"/cases/{caseId}/status":{"patch":{"tags":["Cases"],"summary":"Change status","description":"Logs `status-changed`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"$ref":"#/components/schemas/CaseStatus"}},"required":["status"]}}}}}},
"/cases/{caseId}/lead-investigator":{"patch":{"tags":["Cases"],"summary":"Change lead investigator","description":"Logs `lead-changed`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"officerId":{"type":"string"}},"required":["officerId"]}}}}}},
"/cases/{caseId}/notes":{"post":{"tags":["Cases"],"summary":"Add a note","description":"Author = acting officer. Logs `note-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"text":{"type":"string"}},"required":["text"]}}}}}},
"/cases/{caseId}/documents":{"post":{"tags":["Cases"],"summary":"Add a document","description":"ID prefix D-. Logs `document-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServerResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"title":{"type":"string"},"kind":{"$ref":"#/components/schemas/DocKind"}},"required":["title","kind"]}}}}}},
"/cases/{caseId}/persons":{"post":{"tags":["People"],"summary":"Create a person and add to case","description":"Creates the person (P- id) and links them to the case. Logs `person-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"fullName":{"type":"string"},"type":{"$ref":"#/components/schemas/PersonType"},"phone":{"type":"string"},"address":{"type":"string"}},"required":["fullName","type"]}}}}}},
"/cases/{caseId}/persons/link":{"post":{"tags":["People"],"summary":"Add an existing person to a case","description":"Idempotent. Logs `person-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"personId":{"type":"string"}},"required":["personId"]}}}}}},
"/cases/{caseId}/persons/{personId}":{"delete":{"tags":["People"],"summary":"Remove a person from a case","description":"Unlinks from this case only. Also deletes edges to this case's incidents/evidence and the person's evidence links for this case. Person record and other cases are untouched.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"name":"personId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. P-001"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
"/persons/{personId}":{"patch":{"tags":["People"],"summary":"Edit a person","description":"Full replace of the editable fields (omitted phone/address/aliases are cleared). Logs an activity entry in every case the person belongs to.","parameters":[{"name":"personId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. P-001"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"fullName":{"type":"string"},"type":{"$ref":"#/components/schemas/PersonType"},"phone":{"type":"string"},"address":{"type":"string"},"knownAliases":{"type":"array","items":{"type":"string"}}},"required":["fullName","type"]}}}}}},
"/cases/{caseId}/incidents":{"post":{"tags":["Incidents"],"summary":"Add an incident","description":"Occurred time cannot be in the future. Logs `incident-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"title":{"type":"string"},"description":{"type":"string"},"type":{"$ref":"#/components/schemas/CaseType"},"locationId":{"type":"string"},"occurredAt":{"type":"string","format":"date-time"},"status":{"$ref":"#/components/schemas/IncidentStatus"}},"required":["title","description","type","locationId","occurredAt","status"]}}}}}},
"/locations":{"post":{"tags":["Locations"],"summary":"Create a location","description":"De-duplicated by lower(name)+lower(city): if it exists, the existing id is returned and nothing is created.","parameters":[{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"city":{"type":"string"},"region":{"type":"string"}},"required":["name","city","region"]}}}}}},
"/cases/{caseId}/visited-locations":{"post":{"tags":["Locations"],"summary":"Record that a person visited a location","description":"Adds a `visited` edge (idempotent).","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"locationId":{"type":"string"},"personId":{"type":"string"}},"required":["locationId","personId"]}}}}}},
"/cases/{caseId}/locations/{locationId}":{"delete":{"tags":["Locations"],"summary":"Remove a location from a case","description":"Deletes this case's `visited` edges and sightings at the location, clears evidence.locationId, and moves the case's incidents to another location (400 if none exists).","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"name":"locationId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. L-001"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
"/cases/{caseId}/vehicles":{"post":{"tags":["Vehicles"],"summary":"Create a vehicle","description":"Duplicate plate returns 409. `connections` link the vehicle to people/incidents; an `owns` connection runs the owner-conflict rule.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Plate already exists","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"registration":{"type":"string"},"make":{"type":"string"},"model":{"type":"string"},"color":{"type":"string"},"connections":{"type":"array","items":{"type":"object","properties":{"targetId":{"type":"string"},"relationship":{"type":"string","enum":["owns","connected-to","involved-in"]}}}}},"required":["registration","make","model","color"]}}}}}},
"/cases/{caseId}/vehicles/{vehicleId}":{"delete":{"tags":["Vehicles"],"summary":"Remove a vehicle from a case","description":"Deletes edges to this case's people/incidents, detaches the owner if in this case, deletes this case's sightings of the vehicle.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"name":"vehicleId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. V-001"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
"/cases/{caseId}/connections":{"post":{"tags":["Graph"],"summary":"Add a relationship edge","description":"`source` must be a person (P-). Target kind depends on relationship: visited->L-, involved-in/witnessed->I-, owns/connected-to->V-. `owns` demotes the previous owner to `connected-to` and logs `vehicle-linked`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"source":{"type":"string"},"target":{"type":"string"},"relationship":{"$ref":"#/components/schemas/Relationship"}},"required":["source","target","relationship"]}}}}}},
"/cases/{caseId}/witness-statements":{"post":{"tags":["Timeline records"],"summary":"Add a witness statement","description":"Times cannot be in the future. Logs `timeline-record-added`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"witnessId":{"type":"string"},"subjectPersonId":{"type":"string"},"locationId":{"type":"string"},"claimedTime":{"type":"string","format":"date-time"},"recordedAt":{"type":"string","format":"date-time"},"text":{"type":"string"}},"required":["witnessId","subjectPersonId","locationId","claimedTime","recordedAt","text"]}}}}}},
"/cases/{caseId}/sightings":{"post":{"tags":["Timeline records"],"summary":"Add a sighting","description":"Needs a vehicleId or personId (or both).","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"source":{"$ref":"#/components/schemas/SightingSource"},"action":{"$ref":"#/components/schemas/SightingAction"},"locationId":{"type":"string"},"timestamp":{"type":"string","format":"date-time"},"vehicleId":{"type":"string"},"personId":{"type":"string"},"description":{"type":"string"}},"required":["source","action","locationId","timestamp","description"]}}}}}},
"/cases/{caseId}/phone-records":{"post":{"tags":["Timeline records"],"summary":"Add a phone record","description":"`cell-tower` needs locationId; `call`/`sms` need otherNumber.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"personId":{"type":"string"},"phoneNumber":{"type":"string"},"kind":{"$ref":"#/components/schemas/PhoneKind"},"timestamp":{"type":"string","format":"date-time"},"locationId":{"type":"string"},"otherNumber":{"type":"string"}},"required":["personId","phoneNumber","kind","timestamp"]}}}}}},
"/cases/{caseId}/evidence":{"post":{"tags":["Evidence"],"summary":"Upload evidence","description":"ID prefix E-; status `collected`; first custody entry created for the acting officer. Logs `evidence-uploaded`.","parameters":[{"name":"caseId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. CASE-00123"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"title":{"type":"string"},"type":{"$ref":"#/components/schemas/EvidenceType"},"description":{"type":"string"},"locationId":{"type":"string"},"linkedPersons":{"type":"array","items":{"type":"string"}}},"required":["title","type","description"]}}}}}},
"/evidence/{evidenceId}/custody":{"post":{"tags":["Evidence"],"summary":"Apply a custody action","description":"State machine: collected/with-officer -> transfer or submit; in-evidence-room -> transfer/analysis-started/released/destroyed; under-analysis -> analysis-completed; analysed -> transfer/submit/released/destroyed; released/destroyed are final. Only the current custodian may transfer/submit/start analysis (unless in the evidence room). Rule violations return 400 with the reason.","parameters":[{"name":"evidenceId","in":"path","required":true,"schema":{"type":"string"},"description":"e.g. E-036"},{"$ref":"#/components/parameters/ActingOfficer"}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationResult"}}}},"400":{"description":"Validation failed (message in `error`)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Record not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"action":{"$ref":"#/components/schemas/CustodyAction"},"toOfficerId":{"type":"string","description":"Required for `transferred`"},"note":{"type":"string"}},"required":["action"]}}}}}}
}
}
